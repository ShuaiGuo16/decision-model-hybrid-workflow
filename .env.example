# One Foundry resource and key for both models.
AZURE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_API_KEY=
AZURE_DECISION_DEPLOYMENT=Decision-1
AZURE_TEXT_DEPLOYMENT=gpt-6-luna

# Alternative decision model through OpenRouter's Decisions API.
# Set typesafe/jev-1.14 to use Jev with the same request format.
OPENROUTER_API_KEY=
OPENROUTER_DECISION_MODEL=openai/gpt-6-luna-decisions

# Optional direct OpenAI branch.
OPENAI_API_KEY=
